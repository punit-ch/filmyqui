# Copy this file to .env and fill it in. Never commit .env.

# TMDB key from https://www.themoviedb.org/settings/api (the "API Key (v3 auth)" value)
API_KEY=

# Optional: use the "API Read Access Token" instead of the key (sent as a Bearer header)
# TMDB_READ_TOKEN=

# Required unless you run with --debug. Signs the session cookie, so keep it secret.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: where the SQLite file lives (point this at a persistent disk when deployed)
# DATABASE_PATH=/var/data/movies.db

# Set to 1 when deployed behind a proxy such as Render, Railway or nginx,
# so rate limiting sees the visitor's real IP address.
# TRUST_PROXY=1
