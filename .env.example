# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).
# On a host such as Render or Railway, set these as environment variables instead of using a file.

# --- TMDB (use ONE of the two) -------------------------------------------------------------
# Recommended: the "API Read Access Token" from https://www.themoviedb.org/settings/api.
# It is sent in a request header, so it never appears in a URL or a log line.
TMDB_READ_TOKEN=
# Or the shorter "API Key (v3 auth)" value (this one travels in the URL query string):
# API_KEY=

# --- Required in production ----------------------------------------------------------------
# Signs login sessions. At least 32 random characters; the app refuses to start without it.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# (Only when running locally with `flask --app app run --debug` can this be left empty.)
SECRET_KEY=

# --- Recommended when deployed -------------------------------------------------------------
# Where the SQLite file lives. Point it at a persistent disk, e.g. /var/data/movies.db
# DATABASE_PATH=/var/data/movies.db

# 1 when running behind Render, Railway, nginx, etc. so rate limiting sees each visitor's real IP.
# The app refuses to start in debug mode while this is 1.
# TRUST_PROXY=1

# Only answer requests for your own domain(s), comma separated.
# ALLOWED_HOSTS=filmyqui.example.com
